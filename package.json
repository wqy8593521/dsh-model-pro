{
  "name": "dsh-model-pro",
  "version": "2.0.0",
  "description": "Model Pro — DSH plugin for llm-pi-ai provider lifecycle: create/edit, custom headers, enable/disable with uninstall-restore safety, smart routing, composites, observability, and per-model connectivity tests",
  "type": "module",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/host.smoke.mjs && node tests/client.smoke.mjs && node tests/picatalog.mjs && node tests/i18n.mjs",
    "run:host": "node scripts/run-host.mjs",
    "install:local": "node scripts/install-local.mjs",
    "prepare": "test -f src/host/index.ts && npm run build || true",
    "prepublishOnly": "npm run build && npm test",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "llm-pi-ai",
    "plugin",
    "bundle",
    "model-provider",
    "settings"
  ],
  "author": "wqy8593521",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wqy8593521/dsh-model-pro.git"
  },
  "bugs": {
    "url": "https://github.com/wqy8593521/dsh-model-pro/issues"
  },
  "homepage": "https://github.com/wqy8593521/dsh-model-pro#readme",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0"
  }
}
